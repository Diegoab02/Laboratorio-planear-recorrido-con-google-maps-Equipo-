<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Laboratorio Google Maps Intents"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="12dp"/>

    <Button
        android:id="@+id/btnUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Ver ubicacion del punto"
        android:onClick="verUbicacion"/>

    <Button
        android:id="@+id/btnRutaSimple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Ruta origen - destino"
        android:onClick="rutaOrigenDestino"/>

    <Button
        android:id="@+id/btnDocenteCercano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Docente mas cercano al estudiante"
        android:onClick="rutaDocenteCercano"/>

    <Button
        android:id="@+id/btnRecorridoCompleto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Recorrido diario (varias paradas)"
        android:onClick="recorridoDiario"/>

</LinearLayout>
